# Copy to .env and fill in. Never commit .env: it holds the admin key.

# Required. Producers paste this into the admin dashboard's "Admin key" field.
# Generate one with:  openssl rand -base64 32
MAGICWALL_ADMIN_KEY=

# Optional, LOCAL TESTING ONLY. true = the admin dashboard fills in the key by itself.
# Anyone who can open the dashboard then gets the key, so set false (or remove) before going live.
MAGICWALL_ADMIN_AUTOFILL=false

# Optional. Password for the first admin account ("admin"), created only while no users exist.
# Log in with it, create the newsroom accounts, then change it.
MAGICWALL_BOOTSTRAP_PASSWORD=

# Optional, LOCAL TESTING ONLY. true = demo accounts field1, field2, desk1, desk2, sports1, admin
# (password Demo@1234). Never enable on a live system.
MAGICWALL_DEMO_USERS=false

# Optional. Live sports feed worker (the demo provider only touches matches linked to a feed).
MAGICWALL_SPORTS_FEED=true

# Optional. Host port for the wall and dashboard (default 8080).
MAGICWALL_PORT=8080
