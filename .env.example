# Copy to .env and fill in. Never commit .env: it holds the admin key.

# Required. Producers paste this into the admin dashboard's "Admin key" field.
# Generate one with:  openssl rand -base64 32
MAGICWALL_ADMIN_KEY=

# Optional, LOCAL TESTING ONLY. true = the admin dashboard fills in the key by itself.
# Anyone who can open the dashboard then gets the key, so set false (or remove) before going live.
MAGICWALL_ADMIN_AUTOFILL=false

# Optional. Password for the first admin account ("admin"), created only while no users exist.
# Log in with it, create the newsroom accounts, then change it.
MAGICWALL_BOOTSTRAP_PASSWORD=

# Optional, LOCAL TESTING ONLY. true = demo accounts field1, field2, desk1, desk2, sports1, admin
# (password Demo@1234). Never enable on a live system.
MAGICWALL_DEMO_USERS=false

# Optional. Live sports feed worker (the demo provider only touches matches linked to a feed).
MAGICWALL_SPORTS_FEED=true

# Optional. Where live sports data comes from:
#   Demo          generated events, for rehearsal (default)
#   FootballData  football-data.org: fixtures + scores; goals/cards/subs need a paid "Deep Data" plan
#   Http          your own adapter (JSON contract in Modules/Sports/Feed/SportsFeed.cs)
MAGICWALL_SPORTS_PROVIDER=Demo
MAGICWALL_SPORTS_INTERVAL=20

# football-data.org API key (https://www.football-data.org/client/register). Server-side only.
# RPM = your plan's requests per minute: Free 10, Deep Data 30. Every request waits for a free slot.
MAGICWALL_FOOTBALL_DATA_KEY=
MAGICWALL_FOOTBALL_DATA_RPM=10

# TheSportsDB (player photos, team badges). "123" is their public test key (30 requests/minute);
# a premium key allows 100/minute. Pictures are downloaded once and served by this server,
# so the wall itself never needs internet. Set MAGICWALL_SPORTS_MEDIA=false to turn lookups off.
MAGICWALL_THESPORTSDB_KEY=123
MAGICWALL_THESPORTSDB_RPM=30
MAGICWALL_SPORTS_MEDIA=true

# Optional. Host ports. The presenter port serves ONLY the wall (magic-wall.html), the
# interactive hub (interactive-hub.html), read-only data and live updates: no sign-in, no writes.
# The admin port serves the control room (admin-dashboard.html) and every write endpoint.
#   Presenter:  http://<host>:8080/            -> interactive hub
#   Admin:      http://<host>:8081/            -> admin dashboard
#
# To limit a port to one network address, write IP:port. E.g. MAGICWALL_ADMIN_PORT=127.0.0.1:8081
# keeps the control room on this machine only; or use the IP of the control-room network card so
# the studio-floor network cannot reach it at all. (Avoid 0.0.0.0:port: it drops IPv6.)
MAGICWALL_PRESENTER_PORT=8080
MAGICWALL_ADMIN_PORT=8081
