{
  "ConnectionStrings": {
    "MagicWall": "Data Source=magicwall.db"
  },
  "Ports": {
    "Presenter": 8080,
    "Admin": 8081
  },
  "Auth": {
    "BootstrapAdmin": {
      "UserName": "admin",
      "Password": ""
    },
    "SeedDemoUsers": false
  },
  "Sports": {
    "Feed": {
      "Enabled": true,
      "Provider": "Demo",
      "IntervalSeconds": 20,
      "BaseUrl": "",
      "FootballData": {
        "ApiKey": "",
        "BaseUrl": "https://api.football-data.org/v4/",
        "RequestsPerMinute": 10,
        "Competitions": "PL,PD,BL1,SA,FL1,CL,DED,PPL,ELC,BSA,WC,EC"
      }
    },
    "Media": {
      "Enabled": true,
      "Directory": "media",
      "RetryMissAfterDays": 7,
      "MaxImageBytes": 5000000,
      "AllowedImageHosts": "r2.thesportsdb.com,www.thesportsdb.com,thesportsdb.com",
      "TheSportsDb": {
        "ApiKey": "123",
        "BaseUrl": "https://www.thesportsdb.com/api/v1/json/",
        "RequestsPerMinute": 30
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
